# Copy to .env.local for local builds. .env.local is git ignored.
# Public values, inlined into the client bundle at build time.
# Cloudflare's published Turnstile test site key (always passes). The real one is a Workers Builds build variable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Cloudflare Web Analytics beacon token. Leave unset locally and in CI (no beacon).
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
